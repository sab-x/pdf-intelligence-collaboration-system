# ============================================================
#  Copy to .env and fill in real values. NEVER commit .env
# ============================================================

# ---------- App ----------
APP_ENV=development
LOG_LEVEL=INFO

# ---------- Database ----------
DATABASE_URL=postgresql+asyncpg://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---------- Auth ----------
JWT_SECRET=replace_me_with_a_64_byte_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
GUEST_TOKEN_HOURS=24
BCRYPT_ROUNDS=12
RESET_TOKEN_MINUTES=30

# ---------- Google Gemini ----------
GEMINI_API_KEY=
GEMINI_SUMMARY_MODEL=gemini-2.5-flash
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=3

# ---------- Supabase Storage ----------
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=documents
SIGNED_URL_TTL_SECONDS=900

# ---------- Uploads ----------
MAX_UPLOAD_MB=20
MAX_PAGES=500

# ---------- RAG tuning ----------
CHUNK_TARGET_TOKENS=1000
CHUNK_OVERLAP_TOKENS=150
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATES=12
SEMANTIC_SEARCH_THRESHOLD=0.55
DIRECT_SUMMARY_CHAR_LIMIT=400000
CHAT_HISTORY_TURNS=5

# ---------- Email — out of scope ----------
EMAIL_ENABLED=false

# ---------- URLs / CORS ----------
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ---------- Rate limits ----------
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_FORGOT_PASSWORD=3/hour
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_CHAT_PER_SHARE_LINK=60/hour
RATE_LIMIT_UPLOAD=10/hour
MAX_CHAT_MESSAGES_PER_DOCUMENT_PER_DAY=200

# ---------- Frontend (Vite) ----------
# Where the SSE chat stream is sent. Leave EMPTY locally so the request goes
# through Vite's dev proxy like every other call.
#
# On Vercel set this to the Render origin (e.g. https://pdf-intel-api.onrender.com)
# so the stream bypasses the edge rewrite. Edge proxies buffer streamed
# responses: the answer still arrives, but all at once at the end, which
# silently removes token-by-token streaming while appearing to work.
# This is the ONLY route that skips the rewrite — it uses a bearer token, so
# it needs no cookie and has no third-party-cookie problem.
VITE_STREAM_BASE_URL=
